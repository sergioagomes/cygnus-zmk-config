#include "cygnus.dtsi"

&default_kscan {
    row-gpios
        = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;

    col-gpios
        = <&pro_micro 19 GPIO_ACTIVE_HIGH>   /* col0 = F6  (era 0/TX - errado) */
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>   /* col1 = B1  (era 2/SDA - errado) */
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>   /* col2 = B3  (era 4 - errado)     */
        , <&pro_micro 6  GPIO_ACTIVE_HIGH>   /* col3 = D7  (confirmado: E)       */
        , <&pro_micro 8  GPIO_ACTIVE_HIGH>   /* col4 = B4  (confirmado: R)       */
        , <&pro_micro 9  GPIO_ACTIVE_HIGH>   /* col5 = B5  (confirmado: G)       */
        ;
};
